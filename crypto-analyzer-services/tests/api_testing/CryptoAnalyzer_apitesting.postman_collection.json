  "item": [
    {
      "name": "GET all symbols",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
              "\r",
              "pm.test(\"Response is an array\", () => {\r",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time under 2000ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "pm.test(\"Each symbol has required fields\", () => {\r",
              "    const json = pm.response.json();\r",
              "    if (json.length > 0) {\r",
              "        pm.expect(json[0]).to.have.property(\"symbol\");\r",
              "        pm.expect(json[0]).to.have.property(\"base\");\r",
              "        pm.expect(json[0]).to.have.property(\"quote\");\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/symbols",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "symbols"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET latest price",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Has OHLCV fields\", () => {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"open\");\r",
              "    pm.expect(json).to.have.property(\"high\");\r",
              "    pm.expect(json).to.have.property(\"low\");\r",
              "    pm.expect(json).to.have.property(\"close\");\r",
              "    pm.expect(json).to.have.property(\"volume\");\r",
              "});\r",
              "pm.test(\"Close price is a positive number\", () => {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.close).to.be.a(\"number\").and.above(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/symbols/{{symbol}}/latest",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "symbols",
            "{{symbol}}",
            "latest"
          ]
        }
      },
      "response": []
    },
